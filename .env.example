# Oracle Database Connection Settings
# Read-only user recommended for data extraction
ORACLE_USER=readonly_user
ORACLE_PASSWORD=your_password_here
# DSN example: host:1521/service_name or TNS alias from tnsnames.ora
ORACLE_DSN=localhost:1521/XEPDB1

# Client Mode: 'thin' (default, pure Python) or 'thick' (requires Oracle Client/Instant Client)
ORACLE_CLIENT_MODE=thin

# Oracle Autonomous Database / Wallet Settings (optional)
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=

# Export and Extraction Configuration
EXPORT_DIR=data/exports
BATCH_SIZE=50000
PARQUET_COMPRESSION=zstd
